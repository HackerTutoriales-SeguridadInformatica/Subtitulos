Dialogue: 0,0:00:15.77,0:00:21.27,Cart_A_Ver,,0000,0000,0000,,Obra original, historia\Ny creación de personajes: Akira Toriyama
Dialogue: 0,0:01:41.10,0:01:41.94,Cart_A_Ver,,0000,0000,0000,,TAMAGAMI
Dialogue: 0,0:01:42.02,0:01:46.73,Gen_Main,,0000,0000,0000,,¡Soy Tamagami Número Tres!
Dialogue: 0,0:01:47.32,0:01:49.44,Gen_Main,,0000,0000,0000,,¿Vienes por la Esfera del dragón?
Dialogue: 0,0:01:49.53,0:01:50.65,Gen_Main,,0000,0000,0000,,¡Así es!
Dialogue: 0,0:02:16.22,0:02:17.26,Gen_Main,,0000,0000,0000,,¡Extiéndete!
Dialogue: 0,0:02:56.68,0:02:57.72,Gen_Main,,0000,0000,0000,,¡Nada mal!
Dialogue: 0,0:02:58.64,0:02:59.68,Gen_Main,,0000,0000,0000,,¡Vamos!
Dialogue: 0,0:03:12.57,0:03:15.53,Gen_Main,,0000,0000,0000,,¡Es excelente!
Dialogue: 0,0:03:15.61,0:03:20.37,Gen_Main,,0000,0000,0000,,Es un genio.\NYa se aclimató al aire de este mundo.
Dialogue: 0,0:04:35.94,0:04:37.49,Gen_Main,,0000,0000,0000,,¡Vaya!
Dialogue: 0,0:04:37.57,0:04:38.40,Gen_Main,,0000,0000,0000,,¿Qué?
Dialogue: 0,0:04:38.99,0:04:40.95,Gen_Main,,0000,0000,0000,,¿Qué rayos hace?
Dialogue: 0,0:04:41.03,0:04:42.28,Gen_Main,,0000,0000,0000,,¡Está…!
Dialogue: 0,0:04:45.20,0:04:48.25,Gen_Main,,0000,0000,0000,,¡Vamos! ¡Pelea en serio!
Dialogue: 0,0:04:48.33,0:04:49.75,Gen_Main,,0000,0000,0000,,Está bien.
Dialogue: 0,0:05:20.53,0:05:21.45,Gen_Main,,0000,0000,0000,,¡Toma esto!
Dialogue: 0,0:05:22.32,0:05:24.95,Gen_Main,,0000,0000,0000,,¡Cielos! ¿Puedes hacer eso?
Dialogue: 0,0:06:10.29,0:06:11.95,Gen_Main,,0000,0000,0000,,Bueno, si vas a pelear así…
Dialogue: 0,0:06:12.66,0:06:15.12,Gen_Main,,0000,0000,0000,,¡Ka… Me…!
Dialogue: 0,0:06:25.01,0:06:27.80,Gen_Main,,0000,0000,0000,,¡Ha… Me…!
Dialogue: 0,0:06:30.35,0:06:32.68,Gen_Main,,0000,0000,0000,,¡Ha!
Dialogue: 0,0:07:35.08,0:07:37.92,Gen_Main,,0000,0000,0000,,¡Lo admito! ¡Me rindo!
Dialogue: 0,0:07:38.00,0:07:40.29,Gen_Main,,0000,0000,0000,,Pero puedes seguir peleando, ¿no?
Dialogue: 0,0:07:40.38,0:07:42.38,Gen_Main,,0000,0000,0000,,No tiene sentido.
Dialogue: 0,0:07:42.92,0:07:44.92,Gen_Main,,0000,0000,0000,,Soy consciente de tu poder.
Dialogue: 0,0:07:52.05,0:07:53.47,Gen_Main,,0000,0000,0000,,¡Vaya!
Dialogue: 0,0:07:54.14,0:07:57.52,Gen_Main,,0000,0000,0000,,- ¡Lo logró!\N- Es muy impresionante.
Dialogue: 0,0:07:58.10,0:08:01.19,Gen_Main,,0000,0000,0000,,Entonces, ¿ya puedo llevarme\Nla Esfera del dragón?
Dialogue: 0,0:08:01.27,0:08:03.90,Gen_Main,,0000,0000,0000,,Falta la última batalla.
Dialogue: 0,0:08:04.48,0:08:05.61,Gen_Main,,0000,0000,0000,,¿Qué?
Dialogue: 0,0:08:08.65,0:08:10.45,Gen_Main,,0000,0000,0000,,¡Nunca había visto algo así!
Dialogue: 0,0:08:11.03,0:08:12.78,Gen_Main,,0000,0000,0000,,¿Una última batalla?
Dialogue: 0,0:08:13.45,0:08:16.70,Gen_Main,,0000,0000,0000,,Nunca nadie llegó tan lejos.
Dialogue: 0,0:08:23.96,0:08:25.13,Gen_Main,,0000,0000,0000,,¿Qué es eso?
Dialogue: 0,0:08:25.71,0:08:27.30,Gen_Main,,0000,0000,0000,,¿Qué hace?
Dialogue: 0,0:08:27.38,0:08:28.34,Gen_Main,,0000,0000,0000,,¿Quién sabe?
Dialogue: 0,0:08:51.03,0:08:52.95,Gen_Main,,0000,0000,0000,,Mira bien esto.
Dialogue: 0,0:08:53.03,0:08:55.41,Gen_Main,,0000,0000,0000,,Moveré estos vasos varias veces.
Dialogue: 0,0:08:56.04,0:09:00.37,Gen_Main,,0000,0000,0000,,Si adivinas en cuál vaso\Nse encuentra la Esfera del dragón…
Dialogue: 0,0:09:01.08,0:09:02.96,Gen_Main,,0000,0000,0000,,¡será tuya!
Dialogue: 0,0:09:04.50,0:09:07.09,Gen_Main,,0000,0000,0000,,¿Qué? ¿Eso no es demasiado?
Dialogue: 0,0:09:07.17,0:09:09.51,Gen_Main,,0000,0000,0000,,Entonces, ¿para qué fue la pelea?
Dialogue: 0,0:09:09.59,0:09:12.89,Gen_Main,,0000,0000,0000,,Al parecer, esto es parte de la batalla.
Dialogue: 0,0:09:12.97,0:09:14.97,Gen_Main,,0000,0000,0000,,Bueno, está bien.
Dialogue: 0,0:09:15.05,0:09:16.68,Gen_Main,,0000,0000,0000,,Quieres que adivine, ¿no?
Dialogue: 0,0:09:16.76,0:09:17.85,Gen_Main,,0000,0000,0000,,Así es.
Dialogue: 0,0:09:49.38,0:09:50.55,Gen_Main,,0000,0000,0000,,¿Qué?
Dialogue: 0,0:10:01.48,0:10:03.31,Gen_Main,,0000,0000,0000,,¡Listo! ¿Dónde está?
Dialogue: 0,0:10:03.39,0:10:06.02,Gen_Main,,0000,0000,0000,,¿Cómo alguien podría adivinar eso?
Dialogue: 0,0:10:06.69,0:10:08.36,Gen_Main,,0000,0000,0000,,¿Viste dónde quedó?
Dialogue: 0,0:10:08.44,0:10:09.94,Gen_Main,,0000,0000,0000,,No alcancé a verla.
Dialogue: 0,0:10:10.03,0:10:13.03,Gen_Main,,0000,0000,0000,,La seguí, pero la perdí.
Dialogue: 0,0:10:13.11,0:10:16.24,Gen_Main,,0000,0000,0000,,¡Vamos! ¿Dónde está la Esfera del dragón?
Dialogue: 0,0:10:20.24,0:10:21.58,Gen_Main,,0000,0000,0000,,¿Dónde?
Dialogue: 0,0:10:24.17,0:10:25.54,Gen_Main,,0000,0000,0000,,Está ahí.
Dialogue: 0,0:10:25.62,0:10:28.46,Gen_Main,,0000,0000,0000,,¿Qué? ¿En cuál vaso está?
Dialogue: 0,0:10:29.00,0:10:31.21,Gen_Main,,0000,0000,0000,,No está en los vasos. ¡Está ahí!
Dialogue: 0,0:10:35.38,0:10:36.30,Gen_Main,,0000,0000,0000,,¿Qué?
Dialogue: 0,0:10:40.14,0:10:43.27,Gen_Main,,0000,0000,0000,,La tiraste a lo último, ¿verdad?
Dialogue: 0,0:10:48.73,0:10:50.94,Gen_Main,,0000,0000,0000,,Tienes razón. Es tuya.
Dialogue: 0,0:11:04.16,0:11:05.46,Gen_Main,,0000,0000,0000,,¡Qué bien!
Dialogue: 0,0:11:25.27,0:11:28.90,Gen_Main,,0000,0000,0000,,Me agradas. Eres un buen luchador.
Dialogue: 0,0:11:28.98,0:11:32.11,Gen_Main,,0000,0000,0000,,Ten cuidado\Ny buena suerte con las otras dos.
Dialogue: 0,0:11:33.36,0:11:34.40,Gen_Main,,0000,0000,0000,,¡Gracias!
Dialogue: 0,0:11:49.63,0:11:50.71,Gen_Main,,0000,0000,0000,,¡Eso es!
Dialogue: 0,0:11:52.50,0:11:54.71,Gen_Main,,0000,0000,0000,,¡Bien hecho, chico!
Dialogue: 0,0:11:54.80,0:11:56.38,Gen_Main,,0000,0000,0000,,¡Hurra!
Dialogue: 0,0:11:59.22,0:12:00.34,Gen_Main,,0000,0000,0000,,¡Sí!
Dialogue: 0,0:12:05.39,0:12:09.10,Gen_Main,,0000,0000,0000,,¡No puedo creer que vencieras al Tamagami!
Dialogue: 0,0:12:09.19,0:12:11.15,Gen_Main,,0000,0000,0000,,Bien hecho, Goku.
Dialogue: 0,0:12:12.31,0:12:15.78,Gen_Main,,0000,0000,0000,,Era bastante fuerte.
Dialogue: 0,0:12:19.82,0:12:23.99,Gen_Main,,0000,0000,0000,,Sí. Ya tenemos la Esfera\Ndel Tercer Mundo Demoníaco.
Dialogue: 0,0:12:24.58,0:12:27.62,Gen_Main,,0000,0000,0000,,{\a6\i1}No creí que sería tan fácil.{\i}
Dialogue: 0,0:12:28.71,0:12:31.79,Gen_Main,,0000,0000,0000,,Es muy fuerte, aun en un cuerpo de niño.
Dialogue: 0,0:12:32.38,0:12:35.84,Gen_Main,,0000,0000,0000,,Buen trabajo, Glorio.
Dialogue: 0,0:12:35.92,0:12:39.13,Gen_Main,,0000,0000,0000,,{\a6\i1}Me encargaré de todo, Arinsu.{\i}
Dialogue: 0,0:12:43.80,0:12:48.27,Gen_Main,,0000,0000,0000,,Bien, es hora de pasar al plan principal.
Dialogue: 0,0:13:00.20,0:13:01.70,Gen_Main,,0000,0000,0000,,¡Nos vemos!
Dialogue: 0,0:13:01.78,0:13:04.07,Gen_Main,,0000,0000,0000,,- Hora de irnos.\N- Bien.
Dialogue: 0,0:13:30.56,0:13:33.10,Gen_Main,,0000,0000,0000,,Sigo sorprendida.
Dialogue: 0,0:13:33.19,0:13:35.11,Gen_Main,,0000,0000,0000,,¿Qué tan fuerte eres?
Dialogue: 0,0:13:35.69,0:13:37.61,Gen_Main,,0000,0000,0000,,Hasta usas magia.
Dialogue: 0,0:13:37.69,0:13:38.78,Gen_Main,,0000,0000,0000,,¿Magia?
Dialogue: 0,0:13:38.86,0:13:42.78,Gen_Main,,0000,0000,0000,,Te transformaste\Ny te salieron luces de las manos.
Dialogue: 0,0:13:42.86,0:13:46.58,Gen_Main,,0000,0000,0000,,Sí, es cierto.\NSe parece un poco a la magia.
Dialogue: 0,0:13:46.66,0:13:48.95,Gen_Main,,0000,0000,0000,,¡Muero de hambre!
Dialogue: 0,0:13:57.09,0:13:59.67,Gen_Main,,0000,0000,0000,,¿Cómo funciona su cuerpo?
Dialogue: 0,0:14:00.46,0:14:02.38,Gen_Main,,0000,0000,0000,,¿Hacia dónde nos dirigimos?
Dialogue: 0,0:14:02.47,0:14:06.14,Gen_Main,,0000,0000,0000,,Vamos al Warp-sama\Npara pasar al Segundo Mundo Demoníaco.
Dialogue: 0,0:14:06.22,0:14:10.14,Gen_Main,,0000,0000,0000,,Volaremos entre la tierra y el mar.\NNo queremos ser descubiertos.
Dialogue: 0,0:14:10.22,0:14:15.35,Gen_Main,,0000,0000,0000,,No hay problema. La Policía Militar\Nno podrá usar los radios por un tiempo.
Dialogue: 0,0:14:15.44,0:14:16.86,Gen_Main,,0000,0000,0000,,No.
Dialogue: 0,0:14:16.94,0:14:19.82,Gen_Main,,0000,0000,0000,,Alguien acaba de vencer al Tamagami
Dialogue: 0,0:14:19.90,0:14:24.86,Gen_Main,,0000,0000,0000,,y se llevó la Esfera del dragón.\NLos rumores se esparcirán rápidamente.
Dialogue: 0,0:14:25.99,0:14:26.99,Gen_Main,,0000,0000,0000,,Es cierto.
Dialogue: 0,0:14:52.56,0:14:54.31,Gen_Main,,0000,0000,0000,,Mira, Gomah.
Dialogue: 0,0:14:55.02,0:14:56.69,Gen_Main,,0000,0000,0000,,¿Qué cosa?
Dialogue: 0,0:14:58.15,0:14:59.73,Gen_Main,,0000,0000,0000,,Justo aquí.
Dialogue: 0,0:15:01.19,0:15:03.44,Gen_Main,,0000,0000,0000,,Esa persona a lo lejos.
Dialogue: 0,0:15:04.07,0:15:05.24,Gen_Main,,0000,0000,0000,,¿Qué?
Dialogue: 0,0:15:05.32,0:15:06.70,Gen_Main,,0000,0000,0000,,¿Qué?
Dialogue: 0,0:15:06.78,0:15:08.91,Gen_Main,,0000,0000,0000,,Creo que sé quién es.
Dialogue: 0,0:15:16.46,0:15:20.21,Gen_Main,,0000,0000,0000,,¡Arinsu! ¿Qué rayos hace ahí?
Dialogue: 0,0:15:22.05,0:15:23.51,Gen_Main,,0000,0000,0000,,No lo sé.
Dialogue: 0,0:15:23.59,0:15:28.76,Gen_Main,,0000,0000,0000,,Al parecer,\NArinsu ya sabía sobre Majin Buu.
Dialogue: 0,0:15:31.51,0:15:35.14,Gen_Main,,0000,0000,0000,,Probablemente se lo contó\Nel Gran Rey Demonio Dábura.
Dialogue: 0,0:15:35.85,0:15:37.10,Gen_Main,,0000,0000,0000,,Pero…
Dialogue: 0,0:15:37.19,0:15:40.73,Gen_Main,,0000,0000,0000,,¿Qué está tramando?
Dialogue: 0,0:16:05.51,0:16:07.09,Gen_Main,,0000,0000,0000,,Casi es hora.
Dialogue: 0,0:16:30.74,0:16:33.08,Gen_Main,,0000,0000,0000,,¿Cómo vas, Marba?
Dialogue: 0,0:16:38.41,0:16:40.08,Gen_Main,,0000,0000,0000,,Veamos.
Dialogue: 0,0:16:56.22,0:17:02.40,Gen_Main,,0000,0000,0000,,La parte de Majin Buu que trajiste\Nhace resaltar el sabor.
Dialogue: 0,0:17:02.48,0:17:05.73,Gen_Main,,0000,0000,0000,,Arriesgué mucho para obtenerla.
Dialogue: 0,0:17:05.82,0:17:08.11,Gen_Main,,0000,0000,0000,,Bueno, ya debería estar listo.
Dialogue: 0,0:17:17.12,0:17:19.46,Gen_Main,,0000,0000,0000,,Esta vez debe funcionar.
Dialogue: 0,0:17:20.12,0:17:23.21,Gen_Main,,0000,0000,0000,,El último Majin no logró vencerme.
Dialogue: 0,0:17:23.29,0:17:25.67,Gen_Main,,0000,0000,0000,,No lo sabremos hasta que no esté listo.
Dialogue: 0,0:17:27.42,0:17:32.13,Gen_Main,,0000,0000,0000,,Le agregamos la esencia de Majin Buu.\NDebería funcionar.
Dialogue: 0,0:17:32.72,0:17:37.10,Gen_Main,,0000,0000,0000,,¿"Debería"? ¿No fuiste tú el brujo\Nque creó a Majin Buu?
Dialogue: 0,0:17:41.44,0:17:47.02,Gen_Main,,0000,0000,0000,,¿De qué hablas?\NFue el hechicero Bibidi que creó a Buu.
Dialogue: 0,0:17:49.03,0:17:50.69,Gen_Main,,0000,0000,0000,,Yo sé cuál es la verdad.
Dialogue: 0,0:17:50.78,0:17:54.53,Gen_Main,,0000,0000,0000,,Lo único que hizo fue pedirte\Nque crearas a Buu.
Dialogue: 0,0:17:54.62,0:17:57.95,Gen_Main,,0000,0000,0000,,Bibidi nunca tuvo ese poder.
Dialogue: 0,0:17:59.33,0:18:04.33,Gen_Main,,0000,0000,0000,,Fue Majin Buu quien desató el caos\Ndentro del Reino Demoníaco.
Dialogue: 0,0:18:04.42,0:18:10.59,Gen_Main,,0000,0000,0000,,Los que sobrevivieron de mi raza\Nhuyeron al mundo externo.
Dialogue: 0,0:18:11.34,0:18:12.30,Gen_Main,,0000,0000,0000,,¿Eso crees?
Dialogue: 0,0:18:12.38,0:18:18.39,Gen_Main,,0000,0000,0000,,No te preocupes.\NNo le diré a nadie que tú lo creaste.
Dialogue: 0,0:18:30.19,0:18:33.32,Gen_Main,,0000,0000,0000,,Esa cosa fue un error.
Dialogue: 0,0:18:33.40,0:18:36.66,Gen_Main,,0000,0000,0000,,Para mí no representa un logro.
Dialogue: 0,0:18:38.28,0:18:44.12,Gen_Main,,0000,0000,0000,,Era muy poderoso e imposible de controlar.\NSe volvió loco.
Dialogue: 0,0:18:45.87,0:18:47.79,Gen_Main,,0000,0000,0000,,Cuento contigo.
Dialogue: 0,0:18:47.88,0:18:52.46,Gen_Main,,0000,0000,0000,,Puede que sea una científica brillante,\Npero no puedo crear un Majin.
Dialogue: 0,0:18:52.55,0:18:58.05,Gen_Main,,0000,0000,0000,,Esta vez,\Ndebería ser más fácil de controlar.
Dialogue: 0,0:18:58.14,0:19:01.77,Gen_Main,,0000,0000,0000,,Ahora, coloca saliva allí adentro.
Dialogue: 0,0:19:01.85,0:19:02.68,Gen_Main,,0000,0000,0000,,¿Qué?
Dialogue: 0,0:19:02.77,0:19:09.15,Gen_Main,,0000,0000,0000,,Al incluir tu esencia,\Ncompartirás información sin hablar
Dialogue: 0,0:19:09.23,0:19:11.40,Gen_Main,,0000,0000,0000,,y así será más fácil de controlar.
Dialogue: 0,0:19:12.11,0:19:13.44,Gen_Main,,0000,0000,0000,,Entiendo.
Dialogue: 0,0:19:25.08,0:19:29.50,Gen_Main,,0000,0000,0000,,Si funciona, espero que me recompenses.
Dialogue: 0,0:19:30.38,0:19:33.71,Gen_Main,,0000,0000,0000,,Si me convierto en Gran Rey Demonio.
Dialogue: 0,0:19:33.80,0:19:38.47,Gen_Main,,0000,0000,0000,,Puede que Gomah sea pequeño,\Npero es bastante poderoso.
Dialogue: 0,0:19:39.60,0:19:42.47,Gen_Main,,0000,0000,0000,,No te preocupes, si todo sale mal…
Dialogue: 0,0:19:43.14,0:19:45.81,Gen_Main,,0000,0000,0000,,usaré las Esferas del dragón.
Dialogue: 0,0:19:48.40,0:19:50.15,Gen_Main,,0000,0000,0000,,¿Las Esferas del dragón?
Dialogue: 0,0:19:52.36,0:19:56.78,Gen_Main,,0000,0000,0000,,¿Planeas usar las Esferas del dragón?
Dialogue: 0,0:19:56.86,0:19:59.11,Gen_Main,,0000,0000,0000,,¡Pero eso es imposible!
Dialogue: 0,0:19:59.82,0:20:02.16,Gen_Main,,0000,0000,0000,,No estés tan segura.
Dialogue: 0,0:20:02.24,0:20:04.45,Gen_Main,,0000,0000,0000,,Tengo otros peones en línea…
Dialogue: 0,0:20:04.54,0:20:07.66,Gen_Main,,0000,0000,0000,,{\a6\i1}y ya obtuvieron una de ellas.{\i}
Dialogue: 0,0:20:31.61,0:20:34.73,Gen_Main,,0000,0000,0000,,Sí. Habla Hybis.
Dialogue: 0,0:20:34.82,0:20:36.99,Gen_Main,,0000,0000,0000,,{\a6\i1}¡Soy yo, el rey Kadan!{\i}
Dialogue: 0,0:20:37.69,0:20:40.53,Gen_Main,,0000,0000,0000,,¿Cómo está? Se le oye muy contento.
Dialogue: 0,0:20:40.61,0:20:45.99,Gen_Main,,0000,0000,0000,,{\a6\i1}¡Goku venció al Tamagami\Ny tiene la Esfera del dragón!{\i}
Dialogue: 0,0:20:46.08,0:20:46.91,Gen_Main,,0000,0000,0000,,¿Qué?
Dialogue: 0,0:20:47.00,0:20:48.29,Gen_Main,,0000,0000,0000,,¿Qué?
Dialogue: 0,0:20:48.37,0:20:54.13,Gen_Main,,0000,0000,0000,,Nos acabamos de enterar.\N¡Todos están celebrando!
Dialogue: 0,0:20:58.63,0:21:00.22,Gen_Main,,0000,0000,0000,,{\a6\i1}¿Ah, sí?{\i}
Dialogue: 0,0:21:00.80,0:21:02.80,Gen_Main,,0000,0000,0000,,¡Ya no tienen que ir hacia allá!
Dialogue: 0,0:21:02.89,0:21:07.31,Gen_Main,,0000,0000,0000,,Se dirigen al Warp-sama.\NPueden encontrarse con ellos allí.
Dialogue: 0,0:21:10.02,0:21:11.69,Gen_Main,,0000,0000,0000,,¿Cuánto tardarán en llegar?
Dialogue: 0,0:21:11.77,0:21:15.98,Gen_Main,,0000,0000,0000,,{\a6\i1}Se robaron un avión de la Policía Militar,\Nasí que llegarán en unos días.{\i}
Dialogue: 0,0:21:16.07,0:21:20.53,Gen_Main,,0000,0000,0000,,{\a6\i1}Vayan y descansen en un hotel.\NLos llamaré luego.{\i}
Dialogue: 0,0:21:20.61,0:21:24.41,Gen_Main,,0000,0000,0000,,¿En un hotel? ¿Puedo beber vino?\N¿Vino color barro?
Dialogue: 0,0:21:24.49,0:21:26.66,Gen_Main,,0000,0000,0000,,{\a6\i1}¡Claro! ¡Haz un banquete para todos!{\i}
Dialogue: 0,0:21:27.41,0:21:29.75,Gen_Main,,0000,0000,0000,,Pero usted paga, ¿verdad?
Dialogue: 0,0:21:29.83,0:21:33.63,Gen_Main,,0000,0000,0000,,{\a6\i1}¡Claro! ¡Usa el dinero que te di!{\i}
Dialogue: 0,0:21:33.71,0:21:35.59,Gen_Main,,0000,0000,0000,,Bien. Copiado.
Dialogue: 0,0:21:37.92,0:21:41.47,Gen_Main,,0000,0000,0000,,¡Hurra! ¿Nos quedaremos en un hotel?
Dialogue: 0,0:21:41.55,0:21:43.59,Gen_Main,,0000,0000,0000,,¿Un hotel de cinco estrellas?
Dialogue: 0,0:21:43.68,0:21:46.60,Gen_Main,,0000,0000,0000,,¿Nos darán mucha comida?
Dialogue: 0,0:21:46.68,0:21:49.31,Gen_Main,,0000,0000,0000,,El vino color barro es delicioso.
Dialogue: 0,0:21:49.39,0:21:51.48,Gen_Main,,0000,0000,0000,,Me pregunto a qué sabe.
Dialogue: 0,0:21:53.40,0:21:55.65,Gen_Main,,0000,0000,0000,,Sabe a barro.
Dialogue: 0,0:21:58.53,0:21:59.69,Gen_Main,,0000,0000,0000,,¿Qué?
Dialogue: 0,0:22:00.28,0:22:03.91,Gen_Main,,0000,0000,0000,,Bueno, lo importante\Nes que tienen la Esfera del dragón.
Dialogue: 0,0:22:04.66,0:22:08.62,Gen_Main,,0000,0000,0000,,Oye, ¿el Mundo Demoníaco\Ntambién tiene Esferas del dragón?
Dialogue: 0,0:22:08.70,0:22:12.75,Gen_Main,,0000,0000,0000,,¿Qué? ¿La Tierra\Ntambién tiene Esferas del dragón?
Dialogue: 0,0:22:13.96,0:22:15.50,Gen_Main,,0000,0000,0000,,Cuéntame más.
Dialogue: 0,0:22:20.42,0:22:21.51,Gen_Main,,0000,0000,0000,,¿Qué sucede?
Dialogue: 0,0:22:22.47,0:22:26.26,Gen_Main,,0000,0000,0000,,No eres rey, pero eres igual de arrogante\Nasí que decidí ignorarte.
Dialogue: 0,0:22:28.89,0:22:31.18,Gen_Main,,0000,0000,0000,,Cuéntame más…
Dialogue: 0,0:22:31.27,0:22:33.02,Gen_Main,,0000,0000,0000,,por favor.
Dialogue: 0,0:23:40.67,0:23:45.59,Cart_A_Ver,,0000,0000,0000,,LADRONES
Dialogue: 0,0:23:45.67,0:23:50.55,Cart_A_Ver,,0000,0000,0000,,Subtítulos: Cinthia Perez
